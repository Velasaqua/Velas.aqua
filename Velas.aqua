document.querySelectorAll('.card').forEach(c=>c.onmouseenter=()=>c.style.scale='1.03');document.querySelectorAll('.card').forEach(c=>c.onmouseleave=()=>c.style.scale='1');
body{
margin:0;
font-family:system-ui,-apple-system,BlinkMacSystemFont,sans-serif;
background:#eefbfc;
color:#14343d;
}

.hero{
height:80vh;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
background:linear-gradient(135deg,#00bcd4,#76e4db);
color:white;
padding:20px;
}

.overlay{
max-width:700px;
}

h1{
font-size:4rem;
margin:0;
text-shadow:0 4px 10px rgba(0,0,0,.2);
}

h2{
text-align:center;
font-size:2rem;
margin-bottom:20px;
}

p{
line-height:1.7;
}

.btn{
display:inline-block;
margin-top:20px;
padding:14px 28px;
background:white;
color:#00a0b3;
border-radius:30px;
font-weight:bold;
text-decoration:none;
transition:.3s;
}

.btn:hover{
background:#00a0b3;
color:white;
}

section{
max-width:1100px;
margin:auto;
padding:60px 20px;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
gap:20px;
}

.card{
background:rgba(255,255,255,.75);
backdrop-filter:blur(8px);
border-radius:18px;
padding:20px;
box-shadow:0 10px 25px rgba(0,0,0,.1);
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
}

footer{
background:#0f2e35;
color:white;
text-align:center;
padding:25px;
margin-top:40px;
}
